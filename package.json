{
  "name": "appointment-bot-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "dev": "pnpm --filter appointment-bot dev",
    "smoke": "pnpm --filter appointment-bot smoke",
    "start": "pnpm --filter appointment-bot start",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@types/node": "^24.0.13",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "overrides": {
      "@langchain/core": "1.2.1"
    }
  },
  "packageManager": "pnpm@10.13.1"
}
