# Host install: copy to /etc/caddy/Caddyfile (do not symlink under /root — the
# caddy user cannot read it), then:
#   caddy validate --config /etc/caddy/Caddyfile && systemctl restart caddy
#
# Public: https://fedchenko.slnnzmtl.xyz/webhooks/tomorrow-reminder
# Upstream: http://127.0.0.1:8080/webhooks/tomorrow-reminder (compose loopback)
# Allowlist: EspoCRM egress IPv4 only
# bind: public Contabo IPv4 only (Tailscale already owns :443 on 100.x)

fedchenko.slnnzmtl.xyz {
	bind 13.140.158.49

	@reminder {
		path /webhooks/tomorrow-reminder
		remote_ip 91.99.109.18
	}

	handle @reminder {
		reverse_proxy 127.0.0.1:8080
	}

	handle {
		respond "Forbidden" 403
	}
}
