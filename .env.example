# Required for bootstrap (Gemini)
GOOGLE_API_KEY=

# Optional model overrides (default: gemini-3.1-flash-lite)
# GEMINI_MODEL=gemini-3.1-flash-lite
# SUPERVISOR_MODEL=gemini-3.1-flash-lite
# AGENT_MODEL=gemini-3.1-flash-lite
# Optional: Telegram voice transcription (default: gemini-3.1-flash-lite)
# AUDIO_MODEL=gemini-3.1-flash-lite

# Optional: Gemini explicit context cache for supervisor routing (default on)
# GEMINI_CONTEXT_CACHE=0

# Optional: message history token budget (default 6000)
# MESSAGE_HISTORY_MAX_TOKENS=6000

# Optional: LangGraph SqliteSaver path (default data/checkpoints.sqlite). Survives process restarts.
# CHECKPOINT_DB_PATH=data/checkpoints.sqlite

# EspoCRM MCP origin and API key (sent as the `espocrm_api_key` header)
# Compose: http://espocrm-mcp-server:3000
# Local (MCP published on host): http://127.0.0.1:3000
ESPOCRM_MCP_URL=http://127.0.0.1:3000
ESPOCRM_API_KEY=
ESPOCRM_ASSIGNED_USER_ID=

# Clinic branding overlay (demo defaults in src/shared/clinic-constants.ts).
# Required when NODE_ENV=production (Docker Compose sets this) — container refuses to start if unset.
# CLINIC_ADDRESS=
# CLINIC_MAPS_URL=
# CONSULTATION_SERVICE_ID=
# CLINIC_NAME_UK=
# CLINIC_NAME_EN=
# CLINIC_WELCOME_VENUE_UK=
# CLINIC_DOCTOR_REF_UK=

# Optional: LangSmith tracing (LLM + tool spans + Tier 1 booking events)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=clinic-appointment-bot
# LANGSMITH_ENDPOINT=
# Aliases: LANGCHAIN_TRACING_V2, LANGCHAIN_API_KEY, LANGCHAIN_PROJECT, LANGCHAIN_ENDPOINT
# Chat inputs/outputs are redacted when tracing is on. Set true only for a trusted/EU/self-hosted project.
# LANGSMITH_TRACE_CONTENT=true
# Optional: skip Tier 1 trackEvent only (LLM tracing unaffected)
# ANALYTICS_DISABLED=1

# Optional: Telegram long-polling bot (`pnpm dev` launches when set)
# TELEGRAM_BOT_TOKEN=

# Optional: tomorrow-reminder webhook (requires TELEGRAM_BOT_TOKEN). Long random secret.
# Compose does not publish 8080 — EspoCRM on the same Docker network POSTs
# http://appointment-bot:8080/webhooks/tomorrow-reminder (header X-Webhook-Secret).
# WEBHOOK_SECRET=
# Optional listen port inside the process (default 8080)
# WEBHOOK_PORT=8080

# Optional: existing Contact.cTelegram for `pnpm smoke -- --identity` known path (read/lookup only).
# Write smoke never uses this id and will not create a Contact on it.
# SMOKE_KNOWN_TELEGRAM_ID=
# Optional override for identity known-path telegram id (defaults to SMOKE_KNOWN_TELEGRAM_ID).
# SMOKE_TELEGRAM_ID_A=
# Required for `pnpm smoke -- --write` / `--all` (refused when NODE_ENV=production)
# SMOKE_ALLOW_WRITES=1
# Required in addition if ESPOCRM_MCP_URL is not localhost / espocrm-mcp-server
# SMOKE_ALLOW_REMOTE_CRM=1
# Required for write smoke: Espo user for smoke meetings (not ESPOCRM_ASSIGNED_USER_ID).
# SMOKE_ASSIGNED_USER_ID=
