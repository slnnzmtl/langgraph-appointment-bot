{
  "name": "appointment-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter @personal-assistant/supervisor-framework build && tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "dev": "pnpm --filter @personal-assistant/supervisor-framework build && tsx src/index.ts",
    "smoke": "pnpm --filter @personal-assistant/supervisor-framework build && tsx src/smoke.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@langchain/core": "1.2.1",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/langgraph": "^1.4.8",
    "@personal-assistant/supervisor-framework": "workspace:*",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
